# BLOCK BLITZ Server Environment Variables (Template)
# Copy this file to .env and replace placeholder values with your actual configuration.

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/block-blitz
# For MongoDB Atlas cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/block-blitz?retryWrites=true&w=majority

# JWT Secret & Expiry (Used in Phase 2/3 for Authentication)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
